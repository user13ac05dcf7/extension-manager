<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="extension-manager">
  <schema id="@app_id@" path="/com/mattjakeman/ExtensionManager/">
    <key name="width" type="i">
      <default>800</default>
      <summary>Window Width</summary>
    </key>
    <key name="height" type="i">
      <default>600</default>
      <summary>Window Height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Is Maximized</summary>
      <description>Whether app window is maximized.</description>
    </key>
    <key name="sort-enabled-first" type="b">
      <default>false</default>
      <summary>Sort Enabled First</summary>
      <description>Display enabled extensions first in the installed view.</description>
    </key>
    <key name="extension-repository" type="s">
      <default>'https://shell-extension-registry-550115.gitlab.io/index.json'</default>
      <summary>Extension Repository</summary>
      <description>The signed index (index.json) to browse and install extensions from when GNOME Shell does not set one itself. Empty to use extensions.gnome.org.</description>
    </key>
    <key name="extension-repository-key" type="s">
      <default>'37rwPeZLAvu/3PO70cbnr6trHwutr7SetPnOkCNm5/g='</default>
      <summary>Extension Repository Key</summary>
      <description>The Ed25519 public key (base64 of the raw 32 bytes) that signs the extension repository's index.</description>
    </key>
  </schema>
</schemalist>
